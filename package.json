{
  "name": "animal-care-clinic",
  "productName": "Animal Care Clinic",
  "version": "0.1.0",
  "description": "Patient tracker for Dr. Waleed El-Bourgy's veterinary clinic",
  "author": "Ahmed El-Bourgy <ahmedwalid4499@gmail.com>",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win32": "electron-builder --win --ia32 --config electron-builder.ia32.cjs --publish never",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "dist:win:linux": "npm run build && electron-builder --win --x64 --publish never -c.win.signAndEditExecutable=false",
    "walkthrough": "npm run build && xvfb-run -a node scripts/walkthrough.mjs screenshots",
    "acceptance": "npm run build && xvfb-run -a node scripts/acceptance.mjs acceptance-out",
    "howto": "node scripts/make-howto.mjs",
    "build:cloud": "vite build --mode cloud",
    "server": "node server/index.mjs",
    "sync-test": "npm run build && npm run build:cloud && xvfb-run -a node scripts/sync-test.mjs sync-test-out"
  },
  "build": {
    "appId": "com.animalcareclinic.tracker",
    "productName": "Animal Care Clinic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "afterPack": "build/mac-adhoc-sign.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "AhmedWalid4499",
        "repo": "Animal-Care-Clinic-",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Animal Care Clinic",
      "artifactName": "AnimalCareClinic-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AnimalCareClinic-${version}-portable.exe"
    },
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "11.0",
      "artifactName": "AnimalCareClinic-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Animal Care Clinic",
      "artifactName": "AnimalCareClinic-${version}-mac.dmg"
    },
    "linux": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.1.0",
    "aws4": "1.13.2",
    "bcryptjs": "2.4.3",
    "electron-updater": "6.3.9",
    "fflate": "0.8.2",
    "pg": "8.13.1",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "sql.js": "1.12.0",
    "web-push": "3.6.7",
    "ws": "8.18.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.7.2",
    "electron-builder": "25.1.8",
    "s3rver": "3.7.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
